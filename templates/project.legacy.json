{
  "$schema": "./project.schema.json",
  "schemaVersion": 1,
  "standardsVersion": "1.1.0",
  "mode": "legacy",
  "framework": "unset",
  "platform": "unset",
  "limits": {
    "componentReviewLines": 300,
    "postSplitTargetLines": 150,
    "extractionReviewLines": 50,
    "pullRequestReviewLines": 600,
    "propDrillingDepth": 3,
    "minimumTouchTarget": 44,
    "minimumContrast": 4.5
  },
  "typescript": {
    "anyPolicy": "allow-with-reason",
    "typeAssertionPolicy": "allow-with-reason",
    "explicitParameterTypes": "public-boundaries",
    "explicitReturnTypes": "public-boundaries",
    "strictness": "incremental"
  },
  "testing": {
    "snapshotPolicy": "allow-with-reason",
    "coverage": { "mode": "changed-files", "lines": 80, "branches": 75, "functions": 80, "statements": 80 }
  },
  "stack": { "styling": null, "stateManagement": null, "serverState": null, "unitTestRunner": null, "e2eRunner": null },
  "integrations": {},
  "deviations": []
}
